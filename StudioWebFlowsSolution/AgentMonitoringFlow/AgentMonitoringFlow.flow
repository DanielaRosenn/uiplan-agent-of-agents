{
  "id": "3117f46a-a41a-404e-bc4a-b02322994c27",
  "version": "1.0.0",
  "name": "AgentMonitoringFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 256,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "3c687dc4-848f-4a03-adbf-c0b5fe4dd3db",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "collectAgentMetrics",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 416,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Collect Agent Metrics"
      },
      "inputs": {
        "script": "const sample = [{ name: 'discovery-agent', status: 'healthy', avgMs: 1200 }, { name: 'solution-architect-agent', status: 'healthy', avgMs: 1800 }, { name: 'verifier-agent', status: 'degraded', avgMs: 4200 }];\nreturn { agents: sample, collectedAt: new Date().toISOString() };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "analyzeHealthSignals",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 576,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Analyze Health Signals"
      },
      "inputs": {
        "script": "const metrics = $vars.collectAgentMetrics.output.agents;\nconst failed = metrics.filter(a => a.status === 'failed');\nconst degraded = metrics.filter(a => a.status === 'degraded' || a.avgMs > 3000);\nreturn { totalAgents: metrics.length, healthyAgents: metrics.length - failed.length - degraded.length, degradedAgents: degraded.length, failedAgents: failed.length, alerts: degraded.concat(failed) };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "prepareAlerts",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 736,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Prepare Alerts"
      },
      "inputs": {
        "script": "const health = $vars.analyzeHealthSignals.output;\nreturn { shouldAlert: health.alerts.length > 0, severity: health.failedAgents > 0 ? 'High' : (health.degradedAgents > 0 ? 'Medium' : 'Low'), message: health.alerts.map(a => `${a.name}:${a.status}`).join(', ') || 'All agents healthy' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "writeMonitoringReport",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 896,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Write Monitoring Report"
      },
      "inputs": {
        "script": "const alert = $vars.prepareAlerts.output;\nreturn { reportName: 'agent-health-summary', alert, generatedAt: new Date().toISOString() };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "complete",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1056,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Complete"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "edges": [
