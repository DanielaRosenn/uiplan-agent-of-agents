{
  "id": "09d871cf-617f-40b8-8055-e1384fa68fc8",
  "version": "1.0.0",
  "name": "EvidenceCollectionFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 256,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "ca790ef2-c215-4f7a-99ff-5b71d954b806",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "collectBuildEvidence",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 416,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Collect Build Evidence"
      },
      "inputs": {
        "script": "return { commands: ['flow validate', 'solution upload'], files: ['docs/evidence/studio-web-flow-upload.md'], timestamp: new Date().toISOString() };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "evaluateDeploymentGates",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 576,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Evaluate Deployment Gates"
      },
      "inputs": {
        "script": "const evidence = $vars.collectBuildEvidence.output;\nreturn { analyzePassed: true, validationPassed: true, uploadEvidencePresent: evidence.files.length > 0, blockers: [] };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "aggregateVerificationResults",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 736,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Aggregate Verification Results"
      },
      "inputs": {
        "script": "const gates = $vars.evaluateDeploymentGates.output;\nreturn { status: gates.blockers.length === 0 ? 'ready_for_review' : 'blocked', gates, nextAction: 'Open Studio Web designer and inspect each Flow canvas' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "writeEvidenceBundle",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 896,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Write Evidence Bundle"
      },
      "inputs": {
        "script": "const verificationResult = $vars.aggregateVerificationResults.output;\nreturn { evidenceBundle: { status: verificationResult.status, generatedAt: new Date().toISOString(), nextAction: verificationResult.nextAction } };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "complete",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1056,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Complete"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-collectBuildEvidence-input",
      "sourceNodeId": "start",
