{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/check-skills-update.ps1",
        "timeout": 20,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/touch-plan-refresh.ps1",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
