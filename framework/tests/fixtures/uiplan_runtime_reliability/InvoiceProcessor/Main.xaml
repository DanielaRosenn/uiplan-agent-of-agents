  <Sequence DisplayName="Invoice Processor Fixture" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputDir" />
      <Variable x:TypeArguments="x:String" Name="outputDir" />
      <Variable x:TypeArguments="s:String[]" Name="invoiceFiles" />
      <Variable x:TypeArguments="x:String" Name="invoiceText" />
      <Variable x:TypeArguments="x:String" Name="invoiceNumber" />
      <Variable x:TypeArguments="x:String" Name="invoiceDate" />
      <Variable x:TypeArguments="x:String" Name="totalAmount" />
      <Variable x:TypeArguments="x:String" Name="validationErrors" />
      <Variable x:TypeArguments="x:String" Name="status" />
      <Variable x:TypeArguments="x:String" Name="reportText" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Invoice Processor fixture started"</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <Assign DisplayName="Set input directory" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">inputDir</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(System.Environment.CurrentDirectory, "Data", "Input")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set output directory" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">outputDir</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(System.Environment.CurrentDirectory, "Data", "Output")</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:CreateDirectory ContinueOnError="{x:Null}" Output="{x:Null}" DisplayName="Ensure output directory" sap2010:WorkflowViewState.IdRef="CreateDirectory_1">
      <ui:CreateDirectory.Path>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">outputDir</CSharpValue>
        </InArgument>
      </ui:CreateDirectory.Path>
    </ui:CreateDirectory>
    <Assign DisplayName="List invoice files" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">
          <CSharpReference x:TypeArguments="s:String[]">invoiceFiles</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">
          <CSharpValue x:TypeArguments="s:String[]">System.IO.Directory.GetFiles(inputDir, "*.txt").OrderBy(path =&gt; path).ToArray()</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize CSV header" sap2010:WorkflowViewState.IdRef="Assign_4">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <CSharpReference x:TypeArguments="x:String">reportText</CSharpReference>
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">"FileName,InvoiceNumber,InvoiceDate,TotalAmount,Status,ValidationErrors"</CSharpValue>
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEach x:TypeArguments="x:String" DisplayName="For each invoice file" sap2010:WorkflowViewState.IdRef="ForEach_1">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable">
          <CSharpValue x:TypeArguments="sc:IEnumerable">invoiceFiles</CSharpValue>
        </InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="invoiceFile" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Process invoice file" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:ReadTextFile DisplayName="Read invoice text" sap2010:WorkflowViewState.IdRef="ReadTextFile_1">
              <ui:ReadTextFile.FileName>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">invoiceFile</CSharpValue>
                </InArgument>
              </ui:ReadTextFile.FileName>
              <ui:ReadTextFile.Content>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">invoiceText</CSharpReference>
                </OutArgument>
              </ui:ReadTextFile.Content>
            </ui:ReadTextFile>
            <Assign DisplayName="Extract invoice number" sap2010:WorkflowViewState.IdRef="Assign_5">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">invoiceNumber</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">System.Text.RegularExpressions.Regex.Match(invoiceText, @"^InvoiceNumber:[ \t]*([^\r\n]*)", System.Text.RegularExpressions.RegexOptions.Multiline).Groups[1].Value.Trim()</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Extract invoice date" sap2010:WorkflowViewState.IdRef="Assign_6">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">invoiceDate</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">System.Text.RegularExpressions.Regex.Match(invoiceText, @"^InvoiceDate:[ \t]*([^\r\n]*)", System.Text.RegularExpressions.RegexOptions.Multiline).Groups[1].Value.Trim()</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Extract total amount" sap2010:WorkflowViewState.IdRef="Assign_7">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">totalAmount</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">System.Text.RegularExpressions.Regex.Match(invoiceText, @"^TotalAmount:[ \t]*([^\r\n]*)", System.Text.RegularExpressions.RegexOptions.Multiline).Groups[1].Value.Trim()</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Validate extracted fields" sap2010:WorkflowViewState.IdRef="Assign_8">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">validationErrors</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">((string.IsNullOrWhiteSpace(invoiceNumber) ? "missing invoice number; " : "") + (!System.Text.RegularExpressions.Regex.IsMatch(invoiceDate, @"^\d{4}-\d{2}-\d{2}$") ? "invalid invoice date; " : "") + (!(System.Text.RegularExpressions.Regex.IsMatch(totalAmount, @"^[0-9]+(\.[0-9]{1,2})?$") &amp;&amp; decimal.Parse(totalAmount) &gt; 0) ? "invalid total amount; " : "")).TrimEnd(' ', ';')</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Set validation status" sap2010:WorkflowViewState.IdRef="Assign_9">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">status</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">string.IsNullOrWhiteSpace(validationErrors) ? "Valid" : "Invalid"</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Append CSV row" sap2010:WorkflowViewState.IdRef="Assign_10">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <CSharpReference x:TypeArguments="x:String">reportText</CSharpReference>
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <CSharpValue x:TypeArguments="x:String">reportText + System.Environment.NewLine + string.Join(",", new[] { System.IO.Path.GetFileName(invoiceFile), invoiceNumber, invoiceDate, totalAmount, status, validationErrors })</CSharpValue>
                </InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:WriteTextFile DisplayName="Write CSV report" sap2010:WorkflowViewState.IdRef="WriteTextFile_1">
      <ui:WriteTextFile.FileName>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(outputDir, "invoice-report.csv")</CSharpValue>
        </InArgument>
      </ui:WriteTextFile.FileName>
      <ui:WriteTextFile.Text>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">reportText</CSharpValue>
        </InArgument>
      </ui:WriteTextFile.Text>
    </ui:WriteTextFile>
    <ui:WriteTextFile DisplayName="Write smoke result" sap2010:WorkflowViewState.IdRef="WriteTextFile_2">
      <ui:WriteTextFile.FileName>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(outputDir, "smoke-result.json")</CSharpValue>
        </InArgument>
      </ui:WriteTextFile.FileName>
      <ui:WriteTextFile.Text>
        <InArgument x:TypeArguments="x:String">
          <CSharpValue x:TypeArguments="x:String">"{\"processed\":" + invoiceFiles.Length.ToString() + ",\"report\":\"invoice-report.csv\"}"</CSharpValue>
        </InArgument>
      </ui:WriteTextFile.Text>
    </ui:WriteTextFile>
    <ui:LogMessage DisplayName="Log Complete" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Invoice Processor fixture completed"</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>