<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="4">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <Sequence DisplayName="PublishConfluence">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="OverviewPath" Default="..\..\docs\wiki\confluence-overview.md" />
      <Variable x:TypeArguments="x:String" Name="QuickstartPath" Default="..\..\docs\wiki\confluence-quickstart.md" />
    </Sequence.Variables>
    <ui:InvokeCodedWorkflow DisplayName="PublishPage" WorkflowName="PublishPage">
      <ui:InvokeCodedWorkflow.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="overviewPath">[OverviewPath]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="quickstartPath">[QuickstartPath]</InArgument>
      </ui:InvokeCodedWorkflow.Arguments>
    </ui:InvokeCodedWorkflow>
  </Sequence>
</Activity>
