        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
