{
  "id": "enterprise-intake-flow",
  "name": "Enterprise Intake Triage Flow",
  "description": "AgentHack demo - Routes business intake requests to appropriate handlers",
  "version": "1.0.0",
  "trigger": {
    "type": "manual",
    "displayName": "Manual Trigger - Business Intake"
  },
  "nodes": [
    {
      "id": "receive-intake",
      "type": "input",
      "displayName": "Receive Business Intake",
      "outputs": {
        "businessUnit": {
          "type": "string",
          "description": "Business unit submitting request (FINANCE, HR, OPS, etc.)"
        },
        "intakeId": {
          "type": "string",
          "description": "Unique intake identifier"
        },
        "requestSummary": {
          "type": "string",
          "description": "Brief description of automation request"
        },
        "stakeholders": {
          "type": "array",
          "description": "List of stakeholder emails"
        }
      }
    },
    {
      "id": "classify-request",
      "type": "decision",
      "displayName": "Classify by Business Unit",
      "input": {
        "condition": "{{receive-intake.businessUnit}}"
      },
      "branches": [
        {
          "condition": "FINANCE",
          "next": "route-finance"
        },
        {
          "condition": "HR",
          "next": "route-hr"
        },
        {
          "condition": "OPS",
          "next": "route-ops"
        },
        {
          "default": true,
          "next": "route-shared"
        }
      ]
    },
    {
      "id": "route-finance",
      "type": "orchestrator-queue",
      "displayName": "Add to Finance Queue",
      "config": {
        "queueName": "Q_FINANCE_INTAKE",
        "itemData": {
          "intakeId": "{{receive-intake.intakeId}}",
          "summary": "{{receive-intake.requestSummary}}",
          "businessUnit": "FINANCE",
          "stakeholders": "{{receive-intake.stakeholders}}"
        },
        "priority": "Normal"
      },
      "next": "notify-stakeholders"
    },
    {
      "id": "route-hr",
      "type": "orchestrator-queue",
      "displayName": "Add to HR Queue",
      "config": {
        "queueName": "Q_HR_INTAKE",
        "itemData": {
          "intakeId": "{{receive-intake.intakeId}}",
          "summary": "{{receive-intake.requestSummary}}",
          "businessUnit": "HR",
          "stakeholders": "{{receive-intake.stakeholders}}"
        },
        "priority": "Normal"
      },
      "next": "notify-stakeholders"
    },
    {
      "id": "route-ops",
      "type": "orchestrator-queue",
      "displayName": "Add to Operations Queue",
      "config": {
        "queueName": "Q_OPS_INTAKE",
        "itemData": {
          "intakeId": "{{receive-intake.intakeId}}",
          "summary": "{{receive-intake.requestSummary}}",
          "businessUnit": "OPS",
          "stakeholders": "{{receive-intake.stakeholders}}"
        },
        "priority": "Normal"
      },
      "next": "notify-stakeholders"
    },
    {
      "id": "route-shared",
      "type": "orchestrator-queue",
      "displayName": "Add to Shared Queue",
      "config": {
        "queueName": "Q_SHARED_INTAKE",
        "itemData": {
          "intakeId": "{{receive-intake.intakeId}}",
          "summary": "{{receive-intake.requestSummary}}",
          "businessUnit": "SHARED",
          "stakeholders": "{{receive-intake.stakeholders}}"
        },
        "priority": "Normal"
      },
      "next": "notify-stakeholders"
    },
    {
      "id": "notify-stakeholders",
      "type": "integration-service",
      "displayName": "Send Email Notification",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": "{{receive-intake.stakeholders}}",
          "subject": "Intake {{receive-intake.intakeId}} - Received",
          "body": "Your automation request has been received and routed for review.\n\nIntake ID: {{receive-intake.intakeId}}\nBusiness Unit: {{receive-intake.businessUnit}}\nSummary: {{receive-intake.requestSummary}}\n\nNext steps: Solution architect will review within 2 business days."
        }
      },
      "next": "invoke-orchestrator"
    },
    {
      "id": "invoke-orchestrator",
      "type": "agent-invoke",
      "displayName": "Invoke Builder Orchestrator",
      "config": {
        "agentName": "builder-orchestrator",
        "input": {
          "intake": {
            "businessGoal": "{{receive-intake.requestSummary}}",
            "businessUnit": "{{receive-intake.businessUnit}}",
            "intakeId": "{{receive-intake.intakeId}}",
            "stakeholders": "{{receive-intake.stakeholders}}"
          }
        }
      },
      "next": "complete"
    },
    {
      "id": "complete",
      "type": "output",
      "displayName": "Flow Complete",
      "outputs": {
        "status": "success",
        "intakeId": "{{receive-intake.intakeId}}",
        "routedTo": "{{classify-request.selectedBranch}}",
        "orchestratorInvoked": true
      }
    }
  ],
  "metadata": {
    "category": "AgentHack Demo",
    "tags": ["intake", "triage", "enterprise", "agent-orchestration"],
    "author": "Builder Agent Team",
    "created": "2026-05-17"
  }
}
