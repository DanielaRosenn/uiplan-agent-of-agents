{
  "id": "f33e9bdc-b48c-4c2d-90b3-28c40cc383cc",
  "version": "1.0.0",
  "name": "EnterpriseIntakeFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 256,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "2ec5926a-6c67-447a-b9fc-097886df02cd",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "normalizeIntake",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 416,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Normalize Intake"
      },
      "inputs": {
        "script": "const intake = ($vars.start && $vars.start.output) || {};\nconst businessUnit = String(intake.businessUnit || intake.BusinessUnit || 'OPS').toUpperCase();\nconst intakeId = intake.intakeId || `INTAKE-${Date.now()}`;\nconst stakeholders = Array.isArray(intake.stakeholders) ? intake.stakeholders : ['automation-review@example.com'];\nreturn { intakeId, businessUnit, requestSummary: intake.requestSummary || 'AgentOps Builder automation request', stakeholders };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyRequest",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 576,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Classify Request"
      },
      "inputs": {
        "script": "const intake = $vars.normalizeIntake.output;\nconst routing = { FINANCE: 'Q_FINANCE_INTAKE', HR: 'Q_HR_INTAKE', OPS: 'Q_OPS_INTAKE' };\nconst queueName = routing[intake.businessUnit] || 'Q_SHARED_INTAKE';\nreturn { ...intake, queueName, priority: intake.businessUnit === 'FINANCE' ? 'High' : 'Normal' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "buildQueueItem",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 736,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Build Queue Item Payload"
      },
      "inputs": {
        "script": "const classified = $vars.classifyRequest.output;\nreturn { queueName: classified.queueName, priority: classified.priority, itemData: { intakeId: classified.intakeId, businessUnit: classified.businessUnit, summary: classified.requestSummary, stakeholders: classified.stakeholders } };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "createPlanningRequest",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 896,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Create Planning Request"
      },
      "inputs": {
        "script": "const queueItem = $vars.buildQueueItem.output;\nreturn { status: 'ready_for_planning', planningQueue: 'Q_PLANNING_REQUESTS', payload: queueItem.itemData, audit: { generatedBy: 'EnterpriseIntakeFlow', generatedAt: new Date().toISOString() } };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "complete",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1056,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Complete"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
