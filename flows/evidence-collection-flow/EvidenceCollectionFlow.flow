{
  "id": "evidence-collection-flow",
  "name": "Evidence Collection & Deployment Gate Flow",
  "description": "AgentHack demo - Collects validation evidence and controls deployment",
  "version": "1.0.0",
  "trigger": {
    "type": "manual",
    "displayName": "Manual Trigger - Evidence Collection"
  },
  "nodes": [
    {
      "id": "receive-request",
      "type": "input",
      "displayName": "Receive Evidence Request",
      "outputs": {
        "intakeId": {
          "type": "string",
          "description": "Intake identifier"
        },
        "projectPath": {
          "type": "string",
          "description": "Path to project artifacts"
        },
        "environment": {
          "type": "string",
          "description": "Target environment (dev, test, prod)"
        }
      }
    },
    {
      "id": "collect-ci-telemetry",
      "type": "http-request",
      "displayName": "Collect CI/CD Telemetry",
      "config": {
        "method": "GET",
        "url": "{{cicdEndpoint}}/api/telemetry/{{receive-request.intakeId}}",
        "headers": {
          "Authorization": "Bearer {{orchestratorAsset.CI_API_TOKEN}}"
        }
      },
      "next": "collect-test-results"
    },
    {
      "id": "collect-test-results",
      "type": "storage",
      "displayName": "Collect Test Results",
      "config": {
        "storageType": "orchestrator-storage-bucket",
        "bucket": "test-results",
        "operation": "read",
        "path": "{{receive-request.intakeId}}/test-output.json"
      },
      "next": "invoke-deployment-evidence"
    },
    {
      "id": "invoke-deployment-evidence",
      "type": "agent-invoke",
      "displayName": "Deployment Evidence Agent",
      "config": {
        "agentName": "deployment-evidence-agent",
        "input": {
          "intakeId": "{{receive-request.intakeId}}",
          "ciTelemetry": "{{collect-ci-telemetry.response}}",
          "testResults": "{{collect-test-results.content}}",
          "targetEnvironment": "{{receive-request.environment}}"
        }
      },
      "next": "evaluate-readiness"
    },
    {
      "id": "evaluate-readiness",
      "type": "decision",
      "displayName": "Evaluate Deployment Readiness",
      "input": {
        "condition": "{{invoke-deployment-evidence.output.readiness}}"
      },
      "branches": [
        {
          "condition": "ready",
          "next": "check-environment"
        },
        {
          "condition": "blocked",
          "next": "notify-blockers"
        },
        {
          "condition": "pending",
          "next": "notify-pending"
        }
      ]
    },
    {
      "id": "check-environment",
      "type": "decision",
      "displayName": "Check Target Environment",
      "input": {
        "condition": "{{receive-request.environment}}"
      },
      "branches": [
        {
          "condition": "prod",
          "next": "require-approval"
        },
        {
          "default": true,
          "next": "auto-deploy"
        }
      ]
    },
    {
      "id": "require-approval",
      "type": "action-center-task",
      "displayName": "Production Deployment Approval",
      "config": {
        "title": "Approve Production Deployment - {{receive-request.intakeId}}",
        "priority": "Critical",
        "assignedTo": ["ops-lead@company.com", "release-manager@company.com"],
        "formFields": [
          {
            "name": "evidence",
            "type": "markdown",
            "label": "Evidence Package",
            "value": "{{invoke-deployment-evidence.output.summary}}",
            "readOnly": true
          },
          {
            "name": "decision",
            "type": "choice",
            "label": "Decision",
            "options": ["Approve", "Deny"],
            "required": true
          },
          {
            "name": "signoff",
            "type": "text",
            "label": "Change Request ID",
            "required": true
          }
        ]
      },
      "next": "evaluate-prod-approval"
    },
    {
      "id": "evaluate-prod-approval",
      "type": "decision",
      "displayName": "Evaluate Production Approval",
      "input": {
        "condition": "{{require-approval.result.decision}}"
      },
      "branches": [
        {
          "condition": "Approve",
          "next": "deploy-production"
        },
        {
          "default": true,
          "next": "deployment-denied"
        }
      ]
    },
    {
      "id": "auto-deploy",
      "type": "orchestrator-process",
      "displayName": "Auto-Deploy to Non-Prod",
      "config": {
        "processName": "Deploy_Package",
        "folderPath": "{{receive-request.environment}}",
        "inputArguments": {
          "intakeId": "{{receive-request.intakeId}}",
          "packagePath": "{{receive-request.projectPath}}",
          "environment": "{{receive-request.environment}}"
        }
      },
      "next": "run-smoke-test"
    },
    {
      "id": "deploy-production",
      "type": "orchestrator-process",
      "displayName": "Deploy to Production",
      "config": {
        "processName": "Deploy_Package",
        "folderPath": "Production",
        "inputArguments": {
          "intakeId": "{{receive-request.intakeId}}",
          "packagePath": "{{receive-request.projectPath}}",
          "environment": "prod",
          "changeRequestId": "{{require-approval.result.signoff}}"
        }
      },
      "next": "run-smoke-test"
    },
    {
      "id": "run-smoke-test",
      "type": "orchestrator-process",
      "displayName": "Run Smoke Test",
      "config": {
        "processName": "Smoke_Test_Runner",
        "folderPath": "{{receive-request.environment}}",
        "inputArguments": {
          "intakeId": "{{receive-request.intakeId}}",
          "deploymentId": "{{auto-deploy.jobId || deploy-production.jobId}}"
        }
      },
      "next": "evaluate-smoke"
    },
    {
      "id": "evaluate-smoke",
      "type": "decision",
      "displayName": "Evaluate Smoke Test",
      "input": {
        "condition": "{{run-smoke-test.status}}"
      },
      "branches": [
        {
          "condition": "successful",
          "next": "notify-success"
        },
        {
          "default": true,
          "next": "notify-smoke-failure"
        }
      ]
    },
    {
      "id": "notify-success",
      "type": "integration-service",
      "displayName": "Notify - Deployment Success",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": ["stakeholders", "ops-team@company.com"],
          "subject": "Deployment Successful - {{receive-request.intakeId}}",
          "body": "Environment: {{receive-request.environment}}\nSmoke test: PASSED\n\nEvidence: {{invoke-deployment-evidence.output.summary}}"
        }
      },
      "next": "complete-success"
    },
    {
      "id": "notify-smoke-failure",
      "type": "integration-service",
      "displayName": "Notify - Smoke Test Failed",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": ["dev-team@company.com", "ops-team@company.com"],
          "subject": "ALERT: Smoke Test Failed - {{receive-request.intakeId}}",
          "body": "Environment: {{receive-request.environment}}\nSmoke test: FAILED\n\nLogs: {{run-smoke-test.logs}}\n\nImmediate attention required."
        }
      },
      "next": "complete-smoke-failure"
    },
    {
      "id": "notify-blockers",
      "type": "integration-service",
      "displayName": "Notify - Deployment Blocked",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": ["dev-team@company.com"],
          "subject": "Deployment Blocked - {{receive-request.intakeId}}",
          "body": "Blockers:\n\n{{invoke-deployment-evidence.output.blockers}}"
        }
      },
      "next": "complete-blocked"
    },
    {
      "id": "notify-pending",
      "type": "integration-service",
      "displayName": "Notify - Evidence Pending",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": ["qa-team@company.com"],
          "subject": "Evidence Incomplete - {{receive-request.intakeId}}",
          "body": "Missing evidence:\n\n{{invoke-deployment-evidence.output.pending}}"
        }
      },
      "next": "complete-pending"
    },
    {
      "id": "deployment-denied",
      "type": "integration-service",
      "displayName": "Notify - Deployment Denied",
      "config": {
        "connector": "outlook",
        "action": "send-email",
        "parameters": {
          "to": ["dev-team@company.com"],
          "subject": "Production Deployment Denied - {{receive-request.intakeId}}",
          "body": "Approval denied by: {{require-approval.completedBy}}"
        }
      },
      "next": "complete-denied"
    },
    {
      "id": "complete-success",
      "type": "output",
      "displayName": "Complete - Deployed Successfully",
      "outputs": {
        "status": "deployed",
        "environment": "{{receive-request.environment}}",
        "deploymentId": "{{auto-deploy.jobId || deploy-production.jobId}}",
        "smokeTestPassed": true
      }
    },
    {
      "id": "complete-smoke-failure",
      "type": "output",
      "displayName": "Complete - Smoke Test Failed",
      "outputs": {
        "status": "smoke_test_failed",
        "environment": "{{receive-request.environment}}",
        "deploymentId": "{{auto-deploy.jobId || deploy-production.jobId}}"
      }
    },
    {
      "id": "complete-blocked",
      "type": "output",
      "displayName": "Complete - Deployment Blocked",
      "outputs": {
        "status": "blocked",
        "blockers": "{{invoke-deployment-evidence.output.blockers}}"
      }
    },
    {
      "id": "complete-pending",
      "type": "output",
      "displayName": "Complete - Evidence Pending",
      "outputs": {
        "status": "pending",
        "missing": "{{invoke-deployment-evidence.output.pending}}"
      }
    },
    {
      "id": "complete-denied",
      "type": "output",
      "displayName": "Complete - Deployment Denied",
      "outputs": {
        "status": "denied",
        "environment": "prod"
      }
    }
  ],
  "metadata": {
    "category": "AgentHack Demo",
    "tags": ["evidence", "deployment", "gates", "smoke-test", "agent-orchestration"],
    "author": "Builder Agent Team",
    "created": "2026-05-17"
  }
}
