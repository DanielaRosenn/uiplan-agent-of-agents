#!/usr/bin/env bash
# UiPath submodule guard - pre-commit hook
# Fails the commit if the skills/ submodule drifted or the rule files
# reference unknown skills/verbs.
set -e

# Find a Python that can import the guard module.
PY=""
for candidate in python python3 py; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "submodule-guard: no python on PATH; skipping pre-commit check." >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Prefer the project venv if it exists.
if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
fi

"$PY" -m uipath_claude.skills.submodule_guard
