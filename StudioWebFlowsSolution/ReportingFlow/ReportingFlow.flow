{
  "id": "b090009e-bf5e-44d1-9019-b20a36aaff61",
  "version": "1.0.0",
  "name": "ReportingFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 256,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "f7278433-f247-4bc9-98d2-ed063c79b8d0",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "collectProjectArtifacts",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 416,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Collect Project Artifacts"
      },
      "inputs": {
        "script": "return { docs: ['PDD', 'SDD', 'ADD', 'test-plan', 'deployment-runbook'], flows: ['EnterpriseIntakeFlow', 'SolutionPlanningFlow', 'EvidenceCollectionFlow', 'AgentMonitoringFlow', 'ReportingFlow'] };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "generateExecutiveSummary",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 576,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Generate Executive Summary"
      },
      "inputs": {
        "script": "const artifacts = $vars.collectProjectArtifacts.output;\nreturn { title: 'AgentOps Builder Delivery Summary', summary: `${artifacts.flows.length} Studio Web flows and ${artifacts.docs.length} delivery docs are prepared for review.` };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "generateHandoffReport",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 736,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Generate Handoff Report"
      },
      "inputs": {
        "script": "const executive = $vars.generateExecutiveSummary.output;\nreturn { executive, handoffChecklist: ['Review Studio Web canvases', 'Bind real agents/resources', 'Run non-production smoke tests'] };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "publishReportingPackage",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 896,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Publish Reporting Package"
      },
      "inputs": {
        "script": "const handoff = $vars.generateHandoffReport.output;\nreturn { status: 'published_to_demo_package', handoff, generatedAt: new Date().toISOString() };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "complete",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1056,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Complete"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
