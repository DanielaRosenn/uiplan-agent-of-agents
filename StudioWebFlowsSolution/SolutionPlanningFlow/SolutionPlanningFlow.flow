{
  "id": "5054bbd2-5ebf-4a41-873c-2c00ee98ae04",
  "version": "1.0.0",
  "name": "SolutionPlanningFlow",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 256,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": "6cc3018e-c69d-49e0-8f93-3b249fe93719",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "extractIntakeData",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 416,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Extract Intake Data"
      },
      "inputs": {
        "script": "const trigger = ($vars.start && $vars.start.output) || {};\nconst payload = trigger.payload || trigger.itemData || trigger;\nreturn { intakeId: payload.intakeId || 'INTAKE-DEMO', businessGoal: payload.businessGoal || payload.summary || 'Deliver governed UiPath automation from business intent', businessUnit: payload.businessUnit || 'OPS', stakeholders: payload.stakeholders || ['automation-review@example.com'] };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "runDiscoveryAnalysis",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 576,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Run Discovery Analysis"
      },
      "inputs": {
        "script": "const intake = $vars.extractIntakeData.output;\nreturn { intake, systems: ['UiPath Studio Web', 'Orchestrator', 'Action Center'], risks: ['missing tenant bindings', 'human approval latency'], artifactsRequired: ['PDD', 'SDD', 'ADD', 'test-plan'] };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "draftSolutionDesign",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 736,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Draft Solution Design"
      },
      "inputs": {
        "script": "const discovery = $vars.runDiscoveryAnalysis.output;\nreturn { architecture: 'Flow orchestrates intake, planning, evidence, monitoring, and reporting.', flowCount: 5, agents: ['discovery-agent', 'solution-architect-agent', 'verifier-agent'], handoffRequired: discovery.risks };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "reviewGateDecision",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 896,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Review Gate Decision"
      },
      "inputs": {
        "script": "const design = $vars.draftSolutionDesign.output;\nconst needsHumanReview = design.handoffRequired.length > 0;\nreturn { approvedForBuild: !needsHumanReview, needsHumanReview, reviewReason: needsHumanReview ? design.handoffRequired.join('; ') : 'No blockers' };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "generatePlanningArtifacts",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1056,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Generate Planning Artifacts"
      },
      "inputs": {
        "script": "const intake = $vars.extractIntakeData.output;\nconst review = $vars.reviewGateDecision.output;\nreturn { pdd: `PDD for ${intake.intakeId}`, sdd: 'SDD for AgentOps Builder flow solution', add: 'ADD for supporting coded agents', testPlan: 'Smoke each Flow path with synthetic input', review };"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "complete",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1216,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "Complete"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "edges": [
